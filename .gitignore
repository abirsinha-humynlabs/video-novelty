__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# index + artefacts. The trailing-* form matters: indices are created per
# experiment (.novelty-2sess, .novelty-gpu, ...) and their manifests embed
# absolute paths, so committing them produces churn and merge conflicts for
# state that is regenerated by `novelty index` in minutes.
.novelty*/
*.npz
null.json
novelty-report.html
selection.json

# v2 pipeline state: segments.json, per-episode chunk signatures, staged CSVs.
# Regenerated by scripts/run_v2.py; phase A rebuilds it in ~45 s for 766.
state*/

# demo media (big; regenerate with scripts/prepare_eval_clips.sh)
data/
*.mp4
*.mov
*.mkv

# CSV results -- these live on S3 now (see WORK.md section 9), local is staging
output/
old_output/

# Customer QA exports. Deliberately NOT committed: they carry per-episode
# customer data (episode_uuid, operator_id, city/state, task descriptions) and
# are an input pulled from a spreadsheet, not source. Keep them locally or in
# S3; if you decide this repo is the right home for them, remove these two
# lines knowingly rather than by accident.
rejected_episodes.csv
rejected_repetitive_shorter_segment.csv
Copy of *.csv
# The xlsx is worse than the CSV exports: alongside the same per-episode
# customer data, its hyperlink relationships hold 766 PRESIGNED S3 URLs. Those
# carry AWS credentials for prod and work for anyone holding them, regardless
# of IAM. Committing this file would put working prod credentials in git
# history, where they cannot be removed by deleting the file later.
Copy of *.xlsx
*.xlsx
